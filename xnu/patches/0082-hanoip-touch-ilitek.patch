diff --git a/bsd/dev/hanoip_touch.c b/bsd/dev/hanoip_touch.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/hanoip_touch.c
@@ -0,0 +1,386 @@
+/*
+ * hanoip (Moto G40 Fusion / G60) touch: ILITEK TDDI over a bit-banged SPI bus.
+ *
+ * The ILITEK chip hangs off GENI SE6 (wrapper1 SE0) on SPI pins 59-62, with
+ * reset on TLMM gpio8 and IRQ on TLMM gpio9.  Rather than bring up the GENI
+ * serial engine (whose clock/RCG and pin roles differ from sweet's SE7), this
+ * drives the four SPI lines as plain GPIO.  The bit rate is low but a 43-byte
+ * report takes well under a millisecond.
+ *
+ * Protocol (from motorola ilitek_v3_mmi):
+ *   write: 0x82 len_hi len_lo <data...>
+ *   read : 0x83 , then read N bytes
+ *   AP-mode report is 43 bytes: 10 fingers, 4 bytes each at buf[4*i+1..4],
+ *   x = ((buf[4i+1] & 0xF0) << 4) | buf[4i+2]
+ *   y = ((buf[4i+1] & 0x0F) << 8) | buf[4i+3]
+ *
+ * Pin roles are boot-args so we can probe without a rebuild:
+ *   hptsclk hptsmosi hptsmiso hptscs  (default 59 60 61 62)
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+#define HPT_TLMM_PA     0x03900000u	/* DT TLMM (0x3400000) + NORTH 0x500000 */
+#define HPT_TLMM_SIZE   0x00200000u
+#define HPT_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define HPT_GPIO_IO(n)  (HPT_GPIO_CFG(n) + 4u)
+#define HPT_RESET_PIN   8
+#define HPT_IRQ_PIN     9
+#define HPT_MAX         10
+#define HPT_REPORT_LEN  43
+#define HPT_SPI_WRITE   0x82
+#define HPT_SPI_READ    0x83
+#define HPT_MODE_CTRL   0xF0
+#define HPT_FW_AP_MODE  0x00
+#define HPT_READ_DATA   0xF6
+
+static struct {
+	vm_offset_t gpio;
+	bool started;
+	unsigned clk, mosi, miso, cs;
+} hpt;
+
+static uint32_t
+hpt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+hpt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+hpt_delay(void)
+{
+	/* ~1 us busy wait: slow SPI, but the ILITEK tolerates a wide clock range. */
+	for (volatile int i = 0; i < 200; ++i) {
+		__asm__ volatile("nop");
+	}
+}
+
+static void
+hpt_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out)
+{
+	uint32_t off = HPT_GPIO_CFG(pin);
+	uint32_t cfg = hpt_rd(hpt.gpio, off);
+	if (out) {
+		hpt_wr(hpt.gpio, HPT_GPIO_IO(pin), hpt_rd(hpt.gpio, HPT_GPIO_IO(pin)) | 2u);
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	hpt_wr(hpt.gpio, off, cfg);
+}
+
+static void
+hpt_set(unsigned pin, int val)
+{
+	uint32_t v = hpt_rd(hpt.gpio, HPT_GPIO_IO(pin));
+	v = val ? (v | 2u) : (v & ~2u);
+	hpt_wr(hpt.gpio, HPT_GPIO_IO(pin), v);
+}
+
+static int
+hpt_get(unsigned pin)
+{
+	/* GPIO_IN_OUT bit 0 is the pin's input level (bit 1 is the output latch). */
+	return !!(hpt_rd(hpt.gpio, HPT_GPIO_IO(pin)) & 1u);
+}
+
+/* SPI mode 0: CPOL=0, CPHA=0.  MSB first. */
+static void
+hpt_spi_xfer(const uint8_t *tx, size_t ntx, uint8_t *rx, size_t nrx)
+{
+	hpt_set(hpt.cs, 0);
+	hpt_delay();
+	for (size_t i = 0; i < ntx; ++i) {
+		uint8_t b = tx[i];
+		for (int bit = 7; bit >= 0; --bit) {
+			hpt_set(hpt.mosi, (b >> bit) & 1);
+			hpt_delay();
+			hpt_set(hpt.clk, 1);
+			hpt_delay();
+			hpt_set(hpt.clk, 0);
+			hpt_delay();
+		}
+	}
+	for (size_t i = 0; i < nrx; ++i) {
+		uint8_t b = 0;
+		for (int bit = 7; bit >= 0; --bit) {
+			hpt_delay();
+			hpt_set(hpt.clk, 1);
+			hpt_delay();
+			b = (uint8_t)((b << 1) | hpt_get(hpt.miso));
+			hpt_set(hpt.clk, 0);
+		}
+		rx[i] = b;
+	}
+	hpt_delay();
+	hpt_set(hpt.cs, 1);
+}
+
+static void
+hpt_write(const uint8_t *data, size_t len)
+{
+	uint8_t buf[8];
+	buf[0] = HPT_SPI_WRITE;
+	buf[1] = (uint8_t)(len >> 8);
+	buf[2] = (uint8_t)(len & 0xff);
+	for (size_t i = 0; i < len && i < sizeof(buf) - 3; ++i) {
+		buf[3 + i] = data[i];
+	}
+	hpt_spi_xfer(buf, 3 + len, NULL, 0);
+}
+
+static void
+hpt_read(uint8_t *out, size_t len)
+{
+	uint8_t cmd = HPT_SPI_READ;
+	hpt_spi_xfer(&cmd, 1, out, len);
+}
+
+/* ILITEK ICE-mode: a 4-byte entry, then register access via 0x25 <addr...>. */
+static void
+hpt_ice_enter(void)
+{
+	static const uint8_t open[4] = { 0x25, 0x62, 0x10, 0x18 };
+	hpt_write(open, sizeof(open));
+}
+
+static void
+hpt_ice_read(uint32_t addr, uint8_t *out, size_t len)
+{
+	uint8_t cmd[4] = { 0x25, (uint8_t)addr, (uint8_t)(addr >> 8), (uint8_t)(addr >> 16) };
+	hpt_write(cmd, sizeof(cmd));
+	hpt_read(out, len);
+}
+
+static void
+hpt_reset(void)
+{
+	hpt_gpio(HPT_RESET_PIN, 0, 0, 0x8, true);
+	hpt_set(HPT_RESET_PIN, 0);
+	for (volatile int i = 0; i < 200000; ++i) {
+		__asm__ volatile("nop");
+	}
+	hpt_set(HPT_RESET_PIN, 1);
+	for (volatile int i = 0; i < 400000; ++i) {
+		__asm__ volatile("nop");
+	}
+}
+
+static void
+hpt_report(void)
+{
+	uint8_t rep[HPT_REPORT_LEN];
+	hpt_read(rep, sizeof(rep));
+
+	/* Header sanity: the AP-mode report starts with 0xB7. */
+	if (rep[0] != 0xB7) {
+		return;
+	}
+
+	bool down[HPT_MAX] = { false };
+	for (int i = 0; i < HPT_MAX; ++i) {
+		const uint8_t *p = &rep[4 * i + 1];
+		if (p[0] == 0xFF && p[1] == 0xFF && p[2] == 0xFF) {
+			continue;
+		}
+		uint32_t x = ((uint32_t)(p[0] & 0xF0) << 4) | p[1];
+		uint32_t y = ((uint32_t)(p[0] & 0x0F) << 8) | p[2];
+		/* The IC reports in its own resolution; scale to the 1080x2460 panel. */
+		uint32_t px = x * 1080u / 2048u;
+		uint32_t py = y * 2460u / 2048u;
+		down[i] = true;
+		sweet_hid_touch(i, 1, (int)px, (int)py);
+	}
+	for (int i = 0; i < HPT_MAX; ++i) {
+		if (!down[i]) {
+			sweet_hid_touch(i, 0, 0, 0);
+		}
+	}
+}
+
+static void
+hpt_setup_pins(void)
+{
+	hpt_gpio(hpt.clk, 0, 0, 0x8, true);
+	hpt_gpio(hpt.mosi, 0, 0, 0x8, true);
+	hpt_gpio(hpt.miso, 0, 0x2000, 0x8, false);	/* pull-up, input */
+	hpt_gpio(hpt.cs, 0, 0x2000, 0x8, true);
+	hpt_set(hpt.cs, 1);
+}
+
+/* Try every assignment of {clk,mosi,miso,cs} to the candidate pins, once. */
+static void
+hpt_sweep(void)
+{
+	static const unsigned pins[] = { 59, 60, 61, 62, 63, 64, 65 };
+	const int np = (int)(sizeof(pins) / sizeof(pins[0]));
+	uint8_t id[2] = { HPT_MODE_CTRL, HPT_FW_AP_MODE };
+
+	(void)id;
+	hpt_gpio(HPT_IRQ_PIN, 0, 0x2000, 0x8, false);
+	/* Read the candidate pins as inputs, before we drive any of them. */
+	printf("HANOIP TOUCH: idle 59=%d 60=%d 61=%d 62=%d 63=%d 64=%d 65=%d irq=%d\n",
+	    hpt_get(59), hpt_get(60), hpt_get(61), hpt_get(62),
+	    hpt_get(63), hpt_get(64), hpt_get(65), hpt_get(HPT_IRQ_PIN));
+	unsigned hist0 = 0, histff = 0, other = 0;
+	for (int a = 0; a < np; ++a) {
+		for (int b = 0; b < np; ++b) {
+			for (int c = 0; c < np; ++c) {
+				for (int d = 0; d < np; ++d) {
+					if (a == b || a == c || a == d || b == c || b == d || c == d) {
+						continue;
+					}
+					hpt.clk = pins[a];
+					hpt.mosi = pins[b];
+					hpt.miso = pins[c];
+					hpt.cs = pins[d];
+					hpt_setup_pins();
+					hpt_reset();
+					hpt_ice_enter();
+					uint8_t rep[8] = { 0 };
+					hpt_ice_read(0x000000, rep, sizeof(rep));
+					/* Only report results that are neither idle-low nor pull-up. */
+					if (rep[0] == 0x00) {
+						hist0++;
+					} else if (rep[0] == 0xFF) {
+						histff++;
+					} else {
+						other++;
+						if (other <= 12) {
+							printf("HANOIP SWEEP: clk=%u mosi=%u miso=%u cs=%u -> %02x %02x %02x %02x %02x\n",
+							    hpt.clk, hpt.mosi, hpt.miso, hpt.cs,
+							    rep[0], rep[1], rep[2], rep[3], rep[4]);
+						}
+					}
+				}
+			}
+		}
+	}
+	printf("HANOIP TOUCH: sweep over %d pins done: 00=%u ff=%u other=%u\n", np, hist0, histff, other);
+}
+
+static void
+hpt_thread(void *arg, wait_result_t result)
+{
+	uint8_t id[2] = { HPT_MODE_CTRL, HPT_FW_AP_MODE };
+	uint8_t ver[4] = { 0 };
+
+	printf("HANOIP TOUCH: clk=%u mosi=%u miso=%u cs=%u\n",
+	    hpt.clk, hpt.mosi, hpt.miso, hpt.cs);
+
+	/* Bus + control lines. */
+	printf("HANOIP TOUCH: probing TLMM bases (cfg/io per pin)\n");
+	{
+		static const unsigned probe[] = { 8, 9, 59, 60, 61, 62 };
+		vm_offset_t a = ml_io_map(0x03400000u, 0x100000u);
+		vm_offset_t b = ml_io_map(0x03900000u, 0x100000u);
+		for (unsigned i = 0; i < sizeof(probe) / sizeof(probe[0]); ++i) {
+			unsigned p = probe[i];
+			printf("HANOIP TOUCH: pin %u A cfg=%08x io=%08x | B cfg=%08x io=%08x\n",
+			    p, hpt_rd(a, HPT_GPIO_CFG(p)), hpt_rd(a, HPT_GPIO_IO(p)),
+			    hpt_rd(b, HPT_GPIO_CFG(p)), hpt_rd(b, HPT_GPIO_IO(p)));
+		}
+	}
+
+	hpt_setup_pins();
+	hpt_gpio(HPT_IRQ_PIN, 0, 0x2000, 0x8, false);
+	{
+		int sweep = 0;
+		(void)PE_parse_boot_argn("hptsweep", &sweep, sizeof(sweep));
+		if (sweep) {
+			hpt_sweep();
+			printf("HANOIP TOUCH: sweep done\n");
+			(void)thread_terminate(current_thread());
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+
+	/* Probe: idle levels of the four lines before any reset. */
+	printf("HANOIP TOUCH: idle clk=%d mosi=%d miso=%d cs=%d irq=%d\n",
+	    hpt_get(hpt.clk), hpt_get(hpt.mosi), hpt_get(hpt.miso),
+	    hpt_get(hpt.cs), hpt_get(HPT_IRQ_PIN));
+
+	hpt_reset();
+	printf("HANOIP TOUCH: after reset irq=%d miso=%d\n",
+	    hpt_get(HPT_IRQ_PIN), hpt_get(hpt.miso));
+
+	/* Switch to AP mode and try to read a report. */
+	hpt_write(id, sizeof(id));
+
+	for (int i = 0; i < 4; ++i) {
+		uint8_t rep[HPT_REPORT_LEN];
+		memset(rep, 0, sizeof(rep));
+		hpt_read(rep, sizeof(rep));
+		printf("HANOIP TOUCH: read%d %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    i, rep[0], rep[1], rep[2], rep[3], rep[4], rep[5], rep[6], rep[7]);
+		for (volatile int k = 0; k < 2000000; ++k) {
+			__asm__ volatile("nop");
+		}
+	}
+
+	(void)ver;
+	/* Steady state: poll the IRQ and read reports. */
+	for (;;) {
+		if (!hpt_get(HPT_IRQ_PIN)) {
+			hpt_report();
+		}
+		for (volatile int k = 0; k < 200000; ++k) {
+			__asm__ volatile("nop");
+		}
+	}
+}
+
+void
+hanoip_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (hpt.started) {
+		return;
+	}
+	hpt.started = true;
+	(void)PE_parse_boot_argn("hanoipts", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("HANOIP TOUCH: disabled (hanoipts=0)\n");
+		return;
+	}
+	hpt.clk = 59;
+	hpt.mosi = 60;
+	hpt.miso = 61;
+	hpt.cs = 62;
+	(void)PE_parse_boot_argn("hptsclk", &hpt.clk, sizeof(hpt.clk));
+	(void)PE_parse_boot_argn("hptsmosi", &hpt.mosi, sizeof(hpt.mosi));
+	(void)PE_parse_boot_argn("hptsmiso", &hpt.miso, sizeof(hpt.miso));
+	(void)PE_parse_boot_argn("hptscs", &hpt.cs, sizeof(hpt.cs));
+
+	uint32_t base = HPT_TLMM_PA;
+	(void)PE_parse_boot_argn("hptbase", &base, sizeof(base));
+	hpt.gpio = ml_io_map(base, HPT_TLMM_SIZE);
+	kern_return_t kr = kernel_thread_start(hpt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("HANOIP TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
